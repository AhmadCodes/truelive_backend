{
  "$id": "urn:truelive:station-protocol:1:CoreStreamEventV1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Core -> Client, report channel logs: stream events.",
  "properties": {
    "app_id": {
      "maxLength": 1024,
      "title": "App Id",
      "type": "string"
    },
    "camera_id": {
      "maxLength": 256,
      "title": "Camera Id",
      "type": "string"
    },
    "camera_name": {
      "maxLength": 1024,
      "title": "Camera Name",
      "type": "string"
    },
    "cell": {
      "title": "Cell",
      "type": "integer"
    },
    "event": {
      "enum": [
        "stream_started",
        "stream_failed",
        "stream_recovered",
        "stream_stopped"
      ],
      "title": "Event",
      "type": "string"
    },
    "group": {
      "maxLength": 64,
      "title": "Group",
      "type": "string"
    },
    "log_level": {
      "maximum": 4,
      "minimum": 0,
      "title": "Log Level",
      "type": "integer"
    },
    "message": {
      "maxLength": 65536,
      "title": "Message",
      "type": "string"
    },
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "outage_since_epoch": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outage Since Epoch"
    },
    "pc_id": {
      "maxLength": 1024,
      "title": "Pc Id",
      "type": "string"
    },
    "pc_name": {
      "maxLength": 1024,
      "title": "Pc Name",
      "type": "string"
    },
    "pid": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Core's own pid (D21); absent on 1.1.0 builds",
      "title": "Pid"
    },
    "reason": {
      "maxLength": 1024,
      "title": "Reason",
      "type": "string"
    },
    "reconnect_attempts": {
      "title": "Reconnect Attempts",
      "type": "integer"
    },
    "screen": {
      "title": "Screen",
      "type": "integer"
    },
    "site_id": {
      "maxLength": 256,
      "title": "Site Id",
      "type": "string"
    },
    "site_name": {
      "maxLength": 1024,
      "title": "Site Name",
      "type": "string"
    },
    "source_id": {
      "maxLength": 256,
      "title": "Source Id",
      "type": "string"
    },
    "station_id": {
      "maxLength": 1024,
      "title": "Station Id",
      "type": "string"
    },
    "station_name": {
      "maxLength": 1024,
      "title": "Station Name",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "title": "Timestamp",
      "type": "string"
    },
    "uri": {
      "maxLength": 2048,
      "not": {
        "pattern": "[A-Za-z][A-Za-z0-9+.-]*://[^\\s]*@"
      },
      "title": "Uri",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9A-Za-z.+_-]{1,64}$",
      "title": "Version",
      "type": "string"
    },
    "view_n": {
      "title": "View N",
      "type": "integer"
    },
    "view_name": {
      "maxLength": 1024,
      "title": "View Name",
      "type": "string"
    }
  },
  "required": [
    "event",
    "timestamp",
    "message_id",
    "app_id",
    "station_id",
    "station_name",
    "pc_id",
    "pc_name",
    "version",
    "log_level",
    "group",
    "message",
    "source_id",
    "site_id",
    "site_name",
    "camera_id",
    "camera_name",
    "uri",
    "reason",
    "screen",
    "view_n",
    "view_name",
    "cell",
    "reconnect_attempts"
  ],
  "title": "CoreStreamEventV1",
  "type": "object",
  "x-truelive-protocol": "truelive-station/1"
}

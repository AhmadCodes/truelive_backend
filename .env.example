# Application
APP_NAME=Shomer Portal API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API Configuration
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://shomer:shomer_password@localhost:5432/shomer_portal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# WebSocket Server
WEBSOCKET_URL=http://localhost:8080
WEBSOCKET_SECRET=your-websocket-secret-key

# JWT for PC Authentication
JWT_SECRET=your-jwt-secret-key-for-pc-auth
JWT_PC_TOKEN_EXPIRE_HOURS=8760

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SureView Integration
SUREVIEW_USERNAME=
SUREVIEW_PASSWORD=
SUREVIEW_API_URL=
SUREVIEW_LOGIN_URL=

# Screenshot Configuration
SCREENSHOT_MAX_AGE_HOURS=24
SCREENSHOT_CAPTURE_TIMEOUT=10
SCREENSHOT_MAX_WORKERS=5
SCREENSHOT_BATCH_TIME_LIMIT=300

# Background Tasks
BACKGROUND_TASK_INTERVAL=600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/uploads

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

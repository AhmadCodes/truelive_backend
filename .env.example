# Application
APP_NAME=TrueLive Portal API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API Configuration
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-change-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://truelive:truelive_password@localhost:5432/truelive_portal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# WebSocket Server
WEBSOCKET_URL=http://localhost:8080
WEBSOCKET_SECRET=your-websocket-secret-key

# JWT for PC Authentication
JWT_SECRET=your-jwt-secret-key-for-pc-auth
JWT_PC_TOKEN_EXPIRE_HOURS=8760

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SureView Integration
SUREVIEW_USERNAME=
SUREVIEW_PASSWORD=
SUREVIEW_API_URL=
SUREVIEW_LOGIN_URL=

# Snapshot Configuration
SNAPSHOT_MAX_AGE_HOURS=24
SNAPSHOT_CAPTURE_TIMEOUT=10
SNAPSHOT_MAX_WORKERS=5
SNAPSHOT_BATCH_TIME_LIMIT=300

# Background Tasks
BACKGROUND_TASK_INTERVAL=600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/uploads

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Shared backend environment (plan 06 D28). docker-compose.yml passes this file
# to backend, websocket, celery_worker and celery_beat, so the API, the relay and
# Celery all read the same values. Each service logs a fingerprint of the
# secrets at start ("startup_check ..."), never the values.

# Fernet key for encrypted system settings. REQUIRED and identical in every
# process. Generate it once and keep it: a new key makes stored encrypted
# settings unreadable. Without it, encrypted core.* settings refuse writes (503).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Shared secret of portal -> relay sender sessions (D12). Empty runs the relay
# legacy-open (any client may push), with a warning at start.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SENDER_SECRET=

# Deploy and relay flags. These are the defaults; docker-compose.yml applies the
# same ones when a flag is missing here.
DEPLOY_INJECT_CONFIG_ID=true
RELAY_STATION_REPORTS=on
DEPLOY_CATCHUP_ENABLED=false
DEPLOY_ACK_TIMEOUT_SEC=300
RELAY_DEBUG_LOGGING=false
# OD-23 (b): refuse PC tokens that differ from the stored pcs.auth_token. Keep
# false (flag token_outdated only) until no station carries an outdated token.
RELAY_REQUIRE_CURRENT_TOKEN=false
# Stream providers (Lumana; docs/STREAM_PROVIDERS.md). false: provider cameras
# are not resolved and their addresses are not renewed (the cells fail alone).
# A provider's key is stored encrypted with SETTINGS_ENCRYPTION_KEY above.
STREAM_PROVIDERS_ENABLED=true

# PC token renewal (D30). The relay sends a new token to a Client >= 1.4.0
# whose token expires within this many days (0 turns expiry renewal off).
PC_TOKEN_RENEW_BEFORE_DAYS=30
# JWT_SECRET rotation window (D30; runbook in DOCKER_SETUP.md). Leave both
# empty outside a rotation. During one, JWT_SECRET_PREVIOUS holds the old
# JWT_SECRET and JWT_ROTATION_GRACE_UNTIL the window end (ISO 8601 UTC, at
# least 14 days out, e.g. 2027-01-31T00:00:00Z). Without an end the previous
# secret is never accepted.
JWT_SECRET_PREVIOUS=
JWT_ROTATION_GRACE_UNTIL=
